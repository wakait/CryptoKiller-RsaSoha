# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local Windows binaries and dependency files
/*.exe
/*.dll
/*.pdb
/*.rlib
/*.d
/.cargo-lock
/.fingerprint/
/build/
/deps/
/incremental/

# Local challenge input (examples/data.txt is the tracked template)
/data.txt

# Packaging output
/rsacracker-windows-x86_64/
/rsacracker-windows-x86_64.zip
/smoke-result.txt
/packaged-result.json

# Local IDE and agent artifacts
.qoder-credits/
.idea/
.vscode/

# OS and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
*.tmp
*.temp
*.bak
*.orig
*.rej

# Local coverage output
/coverage/
/htmlcov/
